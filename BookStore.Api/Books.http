
@baseUrl = http://localhost:5035
@adminToken = 
@userToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..OATW3vo5eAhoqD_SrVkGJmkUvSIKltqAtOfdJHPmsCw



### Get all books
GET http://localhost:5035/books

### Get book by ID
GET http://localhost:5035/books/1

### Login as admin
POST http://localhost:5035/login
Content-Type: application/json

{
    "userName": "admin",
    "password": "1234"
}

### Login as regular user
POST http://localhost:5035/login
Content-Type: application/json

{
    "userName": "user",
    "password": "1234"
}

### Login with incorrect credentials
POST http://localhost:5035/login
Content-Type: application/json

{
    "userName": "admin",
    "password": "wrong"
}


### user info
GET http://localhost:5035/me HTTP/1.1
Authorization: Bearer {{userToken}}


### admin info
GET http://localhost:5035/me HTTP/1.1
Authorization: Bearer {{adminToken}}

### Admin can add a book
POST {{baseUrl}}/books
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "The Clean Coder",
    "authorName": "Robert C. Martin",
    "price": 35.99,
    "releaseDate": "2011-05-23",
    "genre": "Software Engineering"
}

### User cannot add a book
POST {{baseUrl}}/books
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "name": "Test Book",
    "authorName": "Test Author",
    "price": 20.00,
    "releaseDate": "2020-01-01",
    "genre": "Testing"
}

### Admin can update a book
PUT {{baseUrl}}/books/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "id": 1,
    "name": "Clean Code Updated",
    "authorName": "Robert C. Martin",
    "price": 50.00,
    "releaseDate": "2008-08-01",
    "genre": "Software Engineering"
}

### User cannot delete a book
DELETE {{baseUrl}}/books/1
Authorization: Bearer {{userToken}}

### Admin can delete a book
DELETE {{baseUrl}}/books/1
Authorization: Bearer {{adminToken}}